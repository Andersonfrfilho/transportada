{
  "name": "@transportada/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "build": "bun build ./src/main.ts --target=bun --packages=external --outdir=dist",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "dev": "bun --watch ./src/main.ts",
    "lint": "bunx eslint src test eslint.config.js --max-warnings=0",
    "start": "bun ./dist/main.js",
    "test": "bun test ./test/environment.contract.test.ts ./test/health.contract.test.ts ./test/message-envelope.contract.test.ts ./test/message-handler.contract.test.ts ./test/rabbitmq-topology.contract.test.ts ./test/nfe-storage-gateway.contract.test.ts ./test/nfe-messaging.contract.test.ts ./test/nfe-import-consumer.contract.test.ts ./test/nfe-distribution.contract.test.ts ./test/nfe-runtime.contract.test.ts ./test/outbox-relay.contract.test.ts ./test/processed-message.contract.test.ts ./test/shutdown.contract.test.ts",
    "test:integration": "bun test ./test/integration/rabbitmq.integration.ts ./test/integration/sigterm.integration.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@adatechnology/drizzle-provider": "0.1.1",
    "@adatechnology/fiscal-provider": "0.2.0",
    "@adatechnology/logger": "0.0.1",
    "@adatechnology/object-storage-provider": "0.1.1",
    "@adatechnology/rabbitmq-provider": "0.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.3.14",
    "amqplib": "2.0.1",
    "eslint": "9.39.5",
    "globals": "17.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0"
  }
}
