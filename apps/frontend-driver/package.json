{
  "name": "@transportada/frontend-driver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && bun test test/dist.contract.test.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "dev": "vite --host 0.0.0.0 --port ${FRONTEND_DRIVER_PORT:-53200}",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0 --port ${FRONTEND_DRIVER_PORT:-53200}",
    "serve": "bun ./server.ts",
    "smoke": "ENV_FILE=${ENV_FILE:-../../.env}; set -a; . \"$ENV_FILE\"; set +a; DRIVER_SMOKE_PORT=${PLAYWRIGHT_DRIVER_PORT:-53112}; PLAYWRIGHT_DRIVER_PORT=$DRIVER_SMOKE_PORT VITE_DRIVER_APP_URL=http://localhost:$DRIVER_SMOKE_PORT PLAYWRIGHT_TEST_MATCH=driver-service-worker.smoke.spec.ts playwright test && PLAYWRIGHT_DRIVER_PORT=$DRIVER_SMOKE_PORT VITE_DRIVER_APP_URL=http://localhost:$DRIVER_SMOKE_PORT VITE_SMOKE_AUTH_BYPASS=true PLAYWRIGHT_TEST_MATCH=driver-app.smoke.spec.ts playwright test",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-53200}",
    "test": "bun test test/shared.contract.test.ts test/identity.contract.test.ts test/driver-trip.contract.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adatechnology/notification-client": "0.1.0-rc.3",
    "@adatechnology/notification-ui": "0.1.0-rc.9",
    "@tanstack/react-query": "5.90.20",
    "i18next": "25.7.4",
    "keycloak-js": "26.2.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "16.5.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.58.2",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.5",
    "globals": "17.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0"
  }
}
