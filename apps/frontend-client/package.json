{
  "name": "@transportada/frontend-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "dev": "vite --host 0.0.0.0 --port ${FRONTEND_CLIENT_PORT:-53100}",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0 --port ${FRONTEND_CLIENT_PORT:-53100}",
    "serve": "bun ./server.ts",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-53100}",
    "test": "bun test test/shared.contract.test.ts test/deliveries.contract.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.20",
    "keycloak-js": "26.2.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.5",
    "globals": "17.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0"
  }
}
