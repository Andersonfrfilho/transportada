{
  "name": "@transportada/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "build": "bun build ./src/main.ts --target=bun --packages=external --outdir=dist",
    "check": "bun run lint && bun run typecheck && bun test && bun run build",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --output json --config drizzle.config.ts",
    "db:migrate": "bun src/database/database-migration.service.ts",
    "db:seed:local": "bun src/database/local-identity-seed.service.ts",
    "db:test": "bun test ./test/database-migration.contract.test.ts ./test/integration/local-identity-seed.integration.ts",
    "dev": "bun --watch ./src/main.ts",
    "lint": "bunx eslint src test drizzle.config.ts eslint.config.js --max-warnings=0",
    "start": "bun ./dist/main.js",
    "test": "bun test ./test/http.contract.test.ts ./test/cors.contract.test.ts ./test/shutdown.contract.test.ts ./test/database-migration.contract.test.ts ./test/identity-schema.contract.test.ts ./test/fiscal-schema.contract.test.ts ./test/nfe-schema.contract.test.ts ./test/freight-schema.contract.test.ts ./test/billing-schema.contract.test.ts ./test/billing-application.contract.test.ts ./test/freight-calculation-engine.contract.test.ts ./test/freight-rules-application.contract.test.ts ./test/freight-simulation-application.contract.test.ts ./test/freight-http.contract.test.ts ./test/nfe-storage-gateway.contract.test.ts ./test/nfe-import-application.contract.test.ts ./test/nfe-http.contract.test.ts ./test/authentication.contract.test.ts ./test/tenant-context.contract.test.ts ./test/authorization.contract.test.ts ./test/auth-me.contract.test.ts ./test/router.contract.test.ts ./test/router-path-parameters.contract.test.ts ./test/certificate-validation-gateway.contract.test.ts ./test/cryptographic-environment.contract.test.ts ./test/company-settings-application.contract.test.ts ./test/company-settings-http.contract.test.ts ./test/digital-certificate-application.contract.test.ts ./test/digital-certificates-http.contract.test.ts ./test/cte-issuance-schema.contract.test.ts ./test/cte-issuance-application.contract.test.ts",
    "test:integration": "bun test ./test/integration/server.integration.ts ./test/integration/authentication-repository.integration.ts ./test/integration/tenant-context.integration.ts ./test/integration/auth-me.integration.ts ./test/integration/local-identity-seed.integration.ts ./test/integration/company-settings-repository.integration.ts ./test/integration/digital-certificate-repository.integration.ts ./test/integration/billing-repository.integration.ts ./test/database-migration.contract.test.ts ./test/fiscal-schema.contract.test.ts ./test/fiscal-sequence.integration.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@adatechnology/drizzle-provider": "0.1.1",
    "@adatechnology/fiscal-provider": "0.2.0",
    "@adatechnology/keycloak-jwt": "0.1.1",
    "@adatechnology/logger": "0.0.1",
    "@adatechnology/object-storage-provider": "0.1.1",
    "@adatechnology/secret-envelope": "0.1.0",
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.3.14",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "9.39.5",
    "globals": "17.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0"
  }
}
