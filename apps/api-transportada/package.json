{
  "name": "@transportada/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "build": "bun build ./src/main.ts --target=bun --packages=external --outdir=dist",
    "check": "bun run lint && bun run typecheck && bun test && bun run build",
    "dev": "bun --watch ./src/main.ts",
    "lint": "bunx eslint src test eslint.config.js --max-warnings=0",
    "start": "bun ./dist/main.js",
    "test": "bun test ./test/http.contract.test.ts ./test/shutdown.contract.test.ts",
    "test:integration": "bun test ./test/integration/server.integration.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@adatechnology/drizzle-provider": "0.1.1",
    "@adatechnology/logger": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.3.14",
    "eslint": "9.39.5",
    "globals": "17.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0"
  }
}
