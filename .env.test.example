## Ambiente dedicado para E2E e smoke isolado.
APP_NAME=TransportAdA
PROJECT_NAME=transportada
APP_ENV=test
APP_PORT=53101
FRONTEND_PORT=53100
FRONTEND_ORIGIN=http://localhost:53100
VITE_API_URL=http://localhost:53101
VITE_KEYCLOAK_URL=http://localhost:61880
VITE_KEYCLOAK_REALM=transportada-test
VITE_KEYCLOAK_CLIENT_ID=transportada-spa
WORKER_PORT=53102
POSTGRES_PORT=65432
RABBITMQ_PORT=61672
RABBITMQ_MANAGEMENT_PORT=61673
MINIO_PORT=62000
MINIO_CONSOLE_PORT=62001
MAILPIT_SMTP_PORT=61025
