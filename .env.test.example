DATABASE_URL=postgresql://transportada:transportada@localhost:65432/transportada
RABBITMQ_URL=amqp://transportada:transportada@localhost:61672
RABBITMQ_TEST_URL=amqp://transportada:transportada@localhost:61672
KEYCLOAK_PORT=61880
KEYCLOAK_MANAGEMENT_PORT=61902
KEYCLOAK_REALM=transportada-test
KEYCLOAK_ISSUER=http://localhost:61880/realms/transportada-test
KEYCLOAK_JWKS_URI=http://localhost:61880/realms/transportada-test/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=transportada-api
KEYCLOAK_ADMIN_USERNAME=test-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-test-admin-password
# Service account da Admin API (ADR-0022): client confidencial, sem senha de usuário.
KEYCLOAK_ADMIN_CLIENT_ID=transportada-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-test-admin-client-secret
KEYCLOAK_LOCAL_USER_PASSWORD=replace-with-test-user-password
WORKER_PREFETCH=1
FOUNDATION_SYNTHETIC_CONSUMER_ENABLED=false
FOUNDATION_SYNTHETIC_EFFECT_DELAY_MS=0
JWT_SECRET=replace-with-at-least-32-random-bytes
ENCRYPTION_ACTIVE_KEY_ID=test-v1
ENCRYPTION_KEYRING_JSON='{"test-v1":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="}'
IDEMPOTENCY_HMAC_KEY=AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM=
# Chave própria do módulo de notificações: é o HMAC que torna o endereço suprimido irreconhecível.
NOTIFICATION_SUPPRESSION_HMAC_KEY=CQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQk=
QUEUE_PREFIX=transportada_test
STORAGE_PROVIDER=s3
STORAGE_BUCKET=transportada-test
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:62000
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=replace-me
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@test.localhost
SMTP_URL=smtp://localhost:61025
FISCAL_DEFAULT_ENVIRONMENT=homologation
FISCAL_REAL_ISSUANCE_ENABLED=false
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=
