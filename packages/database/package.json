{
  "name": "@transportada/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --output json --config drizzle.config.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "lint": "eslint src scripts drizzle.config.ts",
    "test": "bun test",
    "test:integration": "bun scripts/run-integration-tests.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@adatechnology/drizzle-provider": "0.1.1",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
