{
  "name": "transportada",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "build": "bunx turbo run build",
    "dev": "bunx turbo run dev",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "lint": "bunx turbo run lint",
    "test": "bunx turbo run test",
    "typecheck": "bunx turbo run typecheck",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "trustedDependencies": [
    "@prisma/engines",
    "esbuild",
    "msgpackr-extract",
    "prisma",
    "sharp"
  ],
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.1",
    "eslint": "9.39.5",
    "globals": "17.3.0",
    "prettier": "3.6.2",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
