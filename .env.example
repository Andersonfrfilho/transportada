APP_NAME=TransportAdA
PROJECT_NAME=transportada
APP_ENV=local
APP_PORT=53001
FRONTEND_PORT=53000
# Lista separada por vírgula — painel, landing e portal do contratante são origens diferentes, e as
# três precisam de CORS. O portal é app próprio por decisão de segurança (ADR-0050 §1).
FRONTEND_ORIGIN=http://localhost:53000,http://localhost:53003,http://localhost:53100
VITE_API_URL=http://localhost:53001
VITE_APP_URL=http://localhost:53000
# Endereço da landing pública (apps/frontend-landing) — vira o link de pré-visualização na aba Site.
VITE_LANDING_APP_URL=http://localhost:53003
# Remetente que a prévia de notificação mostra. Mesmo valor do EMAIL_FROM do worker — ausente, a
# prévia mantém o endereço de exemplo do pacote em vez de inventar um.
VITE_EMAIL_FROM=no-reply@localhost
# Endereço do portal do contratante (apps/frontend-client) — ele autentica no mesmo realm, com o
# mesmo cliente SPA, e é a origem para onde o Keycloak devolve o redirect.
VITE_CLIENT_APP_URL=http://localhost:53100
# Site key pública do Cloudflare Turnstile no formulário de candidatura. Vazio não renderiza o
# widget — precisa bater com o TURNSTILE_SECRET_KEY configurado na API para o submit não cair em 403.
VITE_TURNSTILE_SITE_KEY=
# Serviço de OCR self-hosted (Tesseract, `hertzg/tesseract-server`, sem chave de API) que lê
# CNH/CRLV do agregado. Vazio, upload de documento nunca extrai nem aprova sozinho — só manual.
AGGREGATE_DOCUMENT_OCR_URL=
# Matriz de estrada do roteirizador (ADR-0044 §2), hospedada por nós. **Vazio por padrão**: o OSRM
# é opt-in (`make routing-up`) e exige um extract OSM de centenas de MB que nenhuma máquina nova
# tem. Com a variável vazia o consumidor de roteiro não sobe e a sugestão fica na fila; preenchida
# sem serviço no ar, ela falharia com ROUTING_MATRIX_UNAVAILABLE. Nunca cai em linha reta.
# Depois de rodar o runbook: ROUTING_MATRIX_URL=http://localhost:53005
ROUTING_MATRIX_URL=
OSRM_PORT=53005
# Nome do `.osrm` em deploy/osrm/data, sem a extensão — ver docs/runbooks/osrm-extract.md
OSRM_DATASET=area
OSRM_MAX_TABLE_SIZE=2000
# Chave da Geocoding API do Google — o **degrau 2** da escada de geocodificação (spec 069), comprado
# só quando um humano marca a parada como errada. Vazia, a marca responde que a precisão fina não
# está disponível e oferece o pino manual; **nada quebra** e o produto segue roteirizando com a
# precisão de CEP do degrau 1, que é de graça e não pede chave nenhuma.
# ⚠️ Nunca com prefixo `VITE_`: o Vite inlina o literal no bundle.
GEOCODING_API_KEY=
# Ambiente da instalação para o frontend: local | staging | production. Ausente ou desconhecido cai
# em `production` — o valor esquecido no painel não pode fazer a tela do cliente pedir desculpas.
VITE_APP_ENV=local
# Etapa de identificacao antes do login: a pessoa digita e-mail, CPF, CNPJ ou telefone e o provedor
# recebe o login que ele conhece. Desligada por padrao — ligar so depois de conferir em homologacao,
# porque ela mexe no caminho pelo qual todo mundo entra no sistema.
VITE_IDENTIFIER_FIRST_LOGIN=false
VITE_KEYCLOAK_URL=http://localhost:58080
VITE_KEYCLOAK_REALM=transportada-local
VITE_KEYCLOAK_CLIENT_ID=transportada-spa
FRONTEND_LANDING_PORT=53003
FRONTEND_CLIENT_PORT=53100
WORKER_PORT=53002
POSTGRES_PORT=55432
RABBITMQ_PORT=55672
RABBITMQ_MANAGEMENT_PORT=55673
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
MAILPIT_SMTP_PORT=51025
MAILPIT_UI_PORT=58025
DATABASE_URL=postgresql://transportada:transportada@localhost:55432/transportada
RABBITMQ_URL=amqp://transportada:transportada@localhost:55672
RABBITMQ_TEST_URL=amqp://transportada:transportada@localhost:55672
KEYCLOAK_PORT=58080
KEYCLOAK_MANAGEMENT_PORT=59002
KEYCLOAK_REALM=transportada-local
KEYCLOAK_ISSUER=http://localhost:58080/realms/transportada-local
KEYCLOAK_JWKS_URI=http://localhost:58080/realms/transportada-local/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=transportada-api
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-local-development-password
# Service account da Admin API (ADR-0022): client confidencial, sem senha de usuário.
KEYCLOAK_ADMIN_CLIENT_ID=transportada-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-local-admin-client-secret
KEYCLOAK_WORKER_CLIENT_SECRET=replace-with-local-worker-client-secret

# Origem do painel. O rodapé do e-mail de código carrega dela o desenho da Ada Technology; ausente,
# o rodapé assina só em texto. A marca da transportadora não vem daqui — vem do cadastro (aba Site).
APP_BASE_URL=http://localhost:53000

# ADR-0047 — o crachá do worker para acender o MDF-e sozinho. As quatro juntas ou nenhuma: vazias,
# o gatilho fica desligado e o manifesto continua saindo pelo botão do operador.
API_BASE_URL=http://localhost:53001
KEYCLOAK_TOKEN_URL=http://localhost:58080/realms/transportada-local/protocol/openid-connect/token
WORKER_CLIENT_ID=transportada-worker
WORKER_CLIENT_SECRET=replace-with-local-worker-client-secret
KEYCLOAK_LOCAL_USER_PASSWORD=replace-with-local-user-password
# Provisionamento do ambiente (ADR-0021): a empresa única e o primeiro company-admin.
# Vazio nos dois = o passo é pulado; declarar só um dos dois é erro de configuração.
PROVISION_COMPANY_ID=
PROVISION_ADMIN_SUBJECT=
# Primeiro acesso (ADR-0022): sem esta variável a rota de arranque não responde.
# Declarar em branco derruba o boot — quem quer a rota morta não declara a linha.
# Em ambiente publicado o valor é gerado por ambiente e removido depois do primeiro admin.
BOOTSTRAP_TOKEN=replace-with-local-bootstrap-token
WORKER_PREFETCH=1
FOUNDATION_SYNTHETIC_CONSUMER_ENABLED=false
FOUNDATION_SYNTHETIC_EFFECT_DELAY_MS=0
JWT_SECRET=replace-with-at-least-32-random-bytes
ENCRYPTION_ACTIVE_KEY_ID=local-v1
ENCRYPTION_KEYRING_JSON='{"local-v1":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="}'
IDEMPOTENCY_HMAC_KEY=AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM=
# Chave própria do módulo de notificações: é o HMAC que torna o endereço suprimido irreconhecível.
NOTIFICATION_SUPPRESSION_HMAC_KEY=CQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQk=
# Segredo compartilhado com o provedor de entrega. Vazio mantém a rota de recibo fora do ar.
NOTIFICATION_WEBHOOK_SECRET=
# Segredo do Cloudflare Turnstile para a candidatura pública de agregado. Vazio (dev local) aceita
# sem verificar; em produção configurar fecha a porta pra submissão automatizada em massa.
TURNSTILE_SECRET_KEY=
QUEUE_PREFIX=transportada_local
STORAGE_PROVIDER=s3
STORAGE_BUCKET=transportada-local
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:59000
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio-local-password
EMAIL_PROVIDER=smtp
# As duas juntas ou nenhuma: sem elas o convite é criado e o código não sai daqui.
EMAIL_FROM=no-reply@localhost
SMTP_URL=smtp://localhost:51025
FISCAL_DEFAULT_ENVIRONMENT=homologation
FISCAL_REAL_ISSUANCE_ENABLED=false
# infRespTec (NT 2018.005) — identifica quem desenvolveu o emissor, não a transportadora.
# É dado da instalação, e por isso não vem do perfil fiscal da empresa.
# As quatro juntas ou nenhuma: grupo incompleto derruba o boot do worker.
# Ficam comentadas por padrão — valor em branco também derruba o boot.
# CTE_TECHNICAL_RESPONSIBLE_CNPJ=00000000000000
# CTE_TECHNICAL_RESPONSIBLE_CONTACT=Suporte
# CTE_TECHNICAL_RESPONSIBLE_EMAIL=suporte@exemplo.com.br
# CTE_TECHNICAL_RESPONSIBLE_PHONE=1600000000
# Nota RP (NFS-e) — um endereço só: o provedor publica um servidor, e é o de produção (ADR-0035).
# Quem separa uma instalação da outra é a credencial selada por empresa, não a URL. Vazio significa
# provedor não contratado, e o trilho registra a tentativa como não configurada em vez de emitir.
NFSE_PROVIDER_BASE_URL=
NFSE_PROVIDER_TIMEOUT_MS=15000
# Endereço público desta instalação, por onde a prefeitura devolve o postback. Vazio significa
# callback não publicado: a rota anônima nem sobe. Não guarda segredo — o token opaco é por
# empresa, fica no banco e nunca vira variável de ambiente.
API_PUBLIC_URL=
NFSE_CALLBACK_BASE_URL=
# Resumo semanal de preço da ANP (público — sem token), base da URL derivada por semana
# (`arquivos-lpc/<ano>/resumo_semanal_lpc_<domingo>_<sábado>.xlsx`, ADR-0033). A coleta é rotina do
# worker; presença ausente é rotina não configurada, e a janela pousa em `job_run_routine_missing`.
ANP_BASE_URL=https://www.gov.br/anp/pt-br/assuntos/precos-e-defesa-da-concorrencia/precos
ANP_TIMEOUT_MS=15000
# Tarifa homologada de energia da ANEEL (datastore CKAN público — sem token), base do preço do
# kWh do veículo elétrico. A mesma rotina coleta o litro e o kWh, e por isso exige as duas
# agências: metade da coleta gravada é tela com preço sem dizer que está incompleto.
ANEEL_BASE_URL=https://dadosabertos.aneel.gov.br
ANEEL_TIMEOUT_MS=15000
# Catálogo de marca/modelo FIPE (BrasilAPI, pública — sem token). Vazio desliga o recurso e os
# campos de marca/modelo do veículo viram texto livre.
FLEET_VEHICLE_CATALOG_URL=
# Janela do cache do catálogo, em horas. Padrão 720 (trinta dias): marca e modelo mudam em escala
# de mês. Zero pede ao provedor a cada chamada; acima de 8760 (um ano) derruba o boot.
FLEET_VEHICLE_CATALOG_CACHE_HOURS=720
# Terceiro degrau da busca de CEP (spec 050): o banco da instalação vem primeiro, e estes só são
# consultados quando ele não soube o endereço inteiro. Os dois são públicos e sem token. Vazio
# desliga aquele provedor; os dois vazios fazem a escada terminar em casa, e o operador digita.
# ⚠️ O **worker** lê `POSTAL_CODE_BRASIL_API_URL` também (spec 069): é o degrau 1 da geocodificação,
# e a coordenada vem no mesmo corpo que a busca de CEP já pedia. Vazia lá, todo endereço novo cai no
# centroide de município — a sugestão continua saindo, só mais pobre, e diz isso na tela.
POSTAL_CODE_BRASIL_API_URL=https://brasilapi.com.br/api/cep/v2
POSTAL_CODE_VIA_CEP_URL=https://viacep.com.br/ws
# Ambiente fiscal de todo processo de cron (`homologation` · `production`). Não tem padrão no
# schema de propósito: cron que assume ambiente fiscal sozinho é o que emite contra a SEFAZ errada.
FISCAL_ENVIRONMENT=homologation
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=
# Observabilidade. Vazio é o padrão e significa desligado: sem DSN não há rastreio de erro,
# sem sink o log fica só no stdout. SENTRY_ENVIRONMENT vazio cai no APP_ENV.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
LOG_SINK_URL=
# Spec 062 — a Graph API da Meta. **Nenhum segredo aqui**: o token de acesso é por empresa e vive
# selado no banco (`whatsapp_channels`), preenchido pela tela de configuração. Estas duas variáveis
# são só endereço e versão.
# A versão a Meta exige no caminho, e ela envelhece — o padrão é o que estava corrente na escrita.
WHATSAPP_API_VERSION=v23.0
# Vazio aponta para a Graph API de verdade. Preencha só para apontar para um mock local em dev.
WHATSAPP_BASE_URL=
# Spec 062 T005 — convite e recuperação de senha por WhatsApp (lidas pelo **worker**).
# ⚠️ Nome do template **aprovado na Meta**, com o código como único parâmetro do corpo. Vazios, o
# envio cai em texto livre — que a Meta só aceita de quem escreveu para o número nas últimas 24 h, e
# quem recebe um convite nunca escreveu. Em produção, preencha os dois.
# Spec 062 T006 — os dois segredos do **aplicativo** da Meta (lidos pela **api**). São do app, não do
# número: um app assina o webhook de todos os números que administra. O token de acesso, esse é por
# empresa e continua selado no banco.
# ⚠️ Fail-closed: **sem os dois, a rota do webhook não é registrada**. Rota pública que aceita
# qualquer corpo é pior que webhook nenhum, e a Meta não reclama de quem responde 200 a tudo.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_INVITATION_TEMPLATE=
WHATSAPP_PASSWORD_RESET_TEMPLATE=
WHATSAPP_CODE_TEMPLATE_LANGUAGE=pt_BR
