APP_NAME=TransportAdA
APP_ENV=local
APP_PORT=3001
WEB_PORT=3000
DATABASE_URL=postgresql://transportada:transportada@localhost:5432/transportada
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-bytes
ENCRYPTION_KEY=replace-with-a-versioned-32-byte-key
QUEUE_PREFIX=transportada_local
STORAGE_PROVIDER=s3
STORAGE_BUCKET=transportada-local
STORAGE_REGION=us-east-1
