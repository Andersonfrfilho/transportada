APP_NAME=TransportAdA
PROJECT_NAME=transportada
APP_ENV=local
APP_PORT=53001
FRONTEND_PORT=53000
FRONTEND_ORIGIN=http://localhost:53000
VITE_API_URL=http://localhost:53001
VITE_APP_URL=http://localhost:53000
# Ambiente da instalação para o frontend: local | staging | production. Ausente ou desconhecido cai
# em `production` — o valor esquecido no painel não pode fazer a tela do cliente pedir desculpas.
VITE_APP_ENV=local
VITE_KEYCLOAK_URL=http://localhost:58080
VITE_KEYCLOAK_REALM=transportada-local
VITE_KEYCLOAK_CLIENT_ID=transportada-spa
WORKER_PORT=53002
POSTGRES_PORT=55432
RABBITMQ_PORT=55672
RABBITMQ_MANAGEMENT_PORT=55673
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
MAILPIT_SMTP_PORT=51025
MAILPIT_UI_PORT=58025
DATABASE_URL=postgresql://transportada:transportada@localhost:55432/transportada
RABBITMQ_URL=amqp://transportada:transportada@localhost:55672
RABBITMQ_TEST_URL=amqp://transportada:transportada@localhost:55672
KEYCLOAK_PORT=58080
KEYCLOAK_MANAGEMENT_PORT=59002
KEYCLOAK_REALM=transportada-local
KEYCLOAK_ISSUER=http://localhost:58080/realms/transportada-local
KEYCLOAK_JWKS_URI=http://localhost:58080/realms/transportada-local/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=transportada-api
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-local-development-password
# Service account da Admin API (ADR-0022): client confidencial, sem senha de usuário.
KEYCLOAK_ADMIN_CLIENT_ID=transportada-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-local-admin-client-secret
KEYCLOAK_LOCAL_USER_PASSWORD=replace-with-local-user-password
# Provisionamento do ambiente (ADR-0021): a empresa única e o primeiro company-admin.
# Vazio nos dois = o passo é pulado; declarar só um dos dois é erro de configuração.
PROVISION_COMPANY_ID=
PROVISION_ADMIN_SUBJECT=
# Primeiro acesso (ADR-0022): sem esta variável a rota de arranque não responde.
# Declarar em branco derruba o boot — quem quer a rota morta não declara a linha.
# Em ambiente publicado o valor é gerado por ambiente e removido depois do primeiro admin.
BOOTSTRAP_TOKEN=replace-with-local-bootstrap-token
WORKER_PREFETCH=1
FOUNDATION_SYNTHETIC_CONSUMER_ENABLED=false
FOUNDATION_SYNTHETIC_EFFECT_DELAY_MS=0
JWT_SECRET=replace-with-at-least-32-random-bytes
ENCRYPTION_ACTIVE_KEY_ID=local-v1
ENCRYPTION_KEYRING_JSON='{"local-v1":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="}'
IDEMPOTENCY_HMAC_KEY=AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM=
# Chave própria do módulo de notificações: é o HMAC que torna o endereço suprimido irreconhecível.
NOTIFICATION_SUPPRESSION_HMAC_KEY=CQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQk=
# Segredo compartilhado com o provedor de entrega. Vazio mantém a rota de recibo fora do ar.
NOTIFICATION_WEBHOOK_SECRET=
QUEUE_PREFIX=transportada_local
STORAGE_PROVIDER=s3
STORAGE_BUCKET=transportada-local
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:59000
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio-local-password
EMAIL_PROVIDER=smtp
# As duas juntas ou nenhuma: sem elas o convite é criado e o código não sai daqui.
EMAIL_FROM=no-reply@localhost
SMTP_URL=smtp://localhost:51025
FISCAL_DEFAULT_ENVIRONMENT=homologation
FISCAL_REAL_ISSUANCE_ENABLED=false
# infRespTec (NT 2018.005) — identifica quem desenvolveu o emissor, não a transportadora.
# É dado da instalação, e por isso não vem do perfil fiscal da empresa.
# As quatro juntas ou nenhuma: grupo incompleto derruba o boot do worker.
# Ficam comentadas por padrão — valor em branco também derruba o boot.
# CTE_TECHNICAL_RESPONSIBLE_CNPJ=00000000000000
# CTE_TECHNICAL_RESPONSIBLE_CONTACT=Suporte
# CTE_TECHNICAL_RESPONSIBLE_EMAIL=suporte@exemplo.com.br
# CTE_TECHNICAL_RESPONSIBLE_PHONE=1600000000
# Nota RP (NFS-e) — um endereço só: o provedor publica um servidor, e é o de produção (ADR-0035).
# Quem separa uma instalação da outra é a credencial selada por empresa, não a URL. Vazio significa
# provedor não contratado, e o trilho registra a tentativa como não configurada em vez de emitir.
NFSE_PROVIDER_BASE_URL=
NFSE_PROVIDER_TIMEOUT_MS=15000
# Endereço público desta instalação, por onde a prefeitura devolve o postback. Vazio significa
# callback não publicado: a rota anônima nem sobe. Não guarda segredo — o token opaco é por
# empresa, fica no banco e nunca vira variável de ambiente.
NFSE_CALLBACK_BASE_URL=
# Resumo semanal de preço da ANP (público — sem token), base da URL derivada por semana
# (`arquivos-lpc/<ano>/resumo_semanal_lpc_<domingo>_<sábado>.xlsx`, ADR-0033). A batida do cron só
# exige a variável onde a rotina de preço roda; presença ausente é rotina não configurada.
ANP_BASE_URL=https://www.gov.br/anp/pt-br/assuntos/precos-e-defesa-da-concorrencia/precos
ANP_TIMEOUT_MS=15000
# Tarifa homologada de energia da ANEEL (datastore CKAN público — sem token), base do preço do
# kWh do veículo elétrico. A mesma rotina coleta o litro e o kWh, e por isso exige as duas
# agências: metade da coleta gravada é tela com preço sem dizer que está incompleto.
ANEEL_BASE_URL=https://dadosabertos.aneel.gov.br
ANEEL_TIMEOUT_MS=15000
# Catálogo de marca/modelo FIPE (BrasilAPI, pública — sem token). Vazio desliga o recurso e os
# campos de marca/modelo do veículo viram texto livre.
FLEET_VEHICLE_CATALOG_URL=
# Janela do cache do catálogo, em horas. Padrão 720 (trinta dias): marca e modelo mudam em escala
# de mês. Zero pede ao provedor a cada chamada; acima de 8760 (um ano) derruba o boot.
FLEET_VEHICLE_CATALOG_CACHE_HOURS=720
# Terceiro degrau da busca de CEP (spec 050): o banco da instalação vem primeiro, e estes só são
# consultados quando ele não soube o endereço inteiro. Os dois são públicos e sem token. Vazio
# desliga aquele provedor; os dois vazios fazem a escada terminar em casa, e o operador digita.
POSTAL_CODE_BRASIL_API_URL=https://brasilapi.com.br/api/cep/v2
POSTAL_CODE_VIA_CEP_URL=https://viacep.com.br/ws
# Ambiente fiscal de todo processo de cron (`homologation` · `production`). Não tem padrão no
# schema de propósito: cron que assume ambiente fiscal sozinho é o que emite contra a SEFAZ errada.
FISCAL_ENVIRONMENT=homologation
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=
# Observabilidade. Vazio é o padrão e significa desligado: sem DSN não há rastreio de erro,
# sem sink o log fica só no stdout. SENTRY_ENVIRONMENT vazio cai no APP_ENV.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
LOG_SINK_URL=
